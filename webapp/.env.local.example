ANTHROPIC_API_KEY=sk-ant-xxxxx
DATABASE_URL=

# NextAuth (Auth.js) 密钥，用于加密 session/cookie，必须设置。生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# NextAuth 邮箱登录 (SMTP)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# 人工核销后台密码 (/admin/orders?key=xxx)
ADMIN_KEY=
